Table roles {
  id bigint [pk, increment]
  name varchar(60) [not null]
  slug varchar(40) [not null, unique]
  created_at timestamp
  updated_at timestamp
}

Table states {
  id bigint [pk, increment]
  clave char(3) [not null, unique]
  clave_curp char(2) [not null, unique]
  nombre varchar(60) [not null]
}

Table users {
  id bigint [pk, increment]
  role_id bigint [not null]
  name text [not null]
  email text [not null]
  email_hash char(64) [not null, unique]
  rfc text [not null]
  rfc_hash char(64) [not null, unique]
  password varchar(255) [not null]
  address text
  phone text
  website text
  created_at timestamp
  updated_at timestamp
}

Table password_reset_tokens {
  user_id bigint [pk]
  token_hash char(64) [not null, unique]
  expires_at timestamp [not null]
  used_at timestamp
  created_at timestamp
}

Table sessions {
  id varchar(255) [pk]
  user_id bigint [unique]
  ip_address varchar(45)
  user_agent text
  payload longtext [not null]
  last_activity int [not null]

  Indexes {
    last_activity
  }
}

Table collaborators {
  id bigint [pk, increment]
  user_id bigint [not null]
  nombre text [not null]
  correo text [not null]
  correo_hash char(64) [not null]
  rfc text [not null]
  rfc_hash char(64) [not null]
  domicilio_fiscal text [not null]
  curp text [not null]
  curp_hash char(64) [not null, unique]
  numero_seguridad_social text [not null]
  nss_hash char(64) [not null, unique]
  fecha_inicio_laboral date [not null]
  tipo_contrato text [not null]
  departamento text [not null]
  puesto text [not null]
  salario_diario text [not null]
  salario text [not null]
  state_id bigint [not null]
  created_at timestamp
  updated_at timestamp

  Indexes {
    (user_id, correo_hash) [unique]
    (user_id, rfc_hash) [unique]
  }
}

Table managed_users {
  id bigint [pk, increment]
  created_by bigint [not null]
  name text [not null]
  rfc text [not null]
  rfc_hash char(64) [not null]
  address text
  phone text
  website text
  created_at timestamp
  updated_at timestamp

  Indexes {
    (created_by, rfc_hash) [unique]
  }
}

Ref: users.role_id > roles.id [delete: restrict]
Ref: collaborators.user_id > users.id [delete: cascade]
Ref: collaborators.state_id > states.id [delete: restrict]
Ref: managed_users.created_by > users.id [delete: cascade]
Ref: password_reset_tokens.user_id > users.id [delete: cascade]
Ref: sessions.user_id > users.id [delete: cascade]
